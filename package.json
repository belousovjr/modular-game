{
  "name": "modular-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "test": "node --max-old-space-size=2048 --test --test-isolation=none tests/*.test.ts",
    "test:fps": "node scripts/run-module-tests.mjs --fps",
    "test:modules": "node scripts/run-module-tests.mjs --headless",
    "preview": "vite preview --host 127.0.0.1",
    "dev:game": "node server/index.ts",
    "test:online": "node --test --test-isolation=none server/room.test.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "bench:room": "node scripts/benchmark-room.mjs",
    "prepare:room": "node scripts/prepare-room-map.ts",
    "predev": "npm run prepare:room",
    "predev:game": "npm run prepare:room",
    "prebench:room": "npm run prepare:room"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/loaders": "^9.35.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@radix-ui/themes": "^3.3.0",
    "@vercel/functions": "^3.11.3",
    "cannon-es": "^0.20.0",
    "javascript-astar": "0.4.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "assimpjs": "^0.0.10",
    "meshoptimizer": "^1.2.0",
    "rolldown": "^1.2.19",
    "sharp": "^0.34.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
