{
  "name": "modular-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "rolldown": "^1.2.19"
  }
}
