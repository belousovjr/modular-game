{
  "name": "modular-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:fps": "node scripts/run-module-tests.mjs --fps",
    "test:modules": "node scripts/run-module-tests.mjs --headless",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@radix-ui/themes": "^3.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rolldown": "^1.2.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
